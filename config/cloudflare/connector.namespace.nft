# EMPTY destination sets intentionally prevent connectivity until reviewed.
# Load ONLY in the new owned connector's network namespace, NEVER on the host.
# Populate from the pinned connector's current OFFICIAL requirements at approval.
table inet pfme_cf_connector {
  set edges4 { type ipv4_addr; flags interval; }
  set control4 { type ipv4_addr; flags interval; }
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    iifname "lo" accept
  }
  chain output {
    type filter hook output priority 0; policy drop;
    ct state established,related accept
    oifname "lo" accept
    ip daddr @edges4 tcp dport 7844 accept
    ip daddr @control4 tcp dport 443 accept
    ip daddr { 1.1.1.1, 1.0.0.1 } udp dport 53 accept
    ip daddr { 1.1.1.1, 1.0.0.1 } tcp dport 53 accept
  }
  chain forward { type filter hook forward priority 0; policy drop; }
}
